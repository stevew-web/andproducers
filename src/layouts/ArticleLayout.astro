---
import BaseLayout from './BaseLayout.astro';
import { TOPIC_LABELS } from '../utils/topics';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  topic: string;
  author?: string;
  readingTime?: number;
  download?: string;
  image?: string;
  imageAlt?: string;
  type?: 'article' | 'guide' | 'template' | 'playbook';
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  topic,
  author = 'AndProducers',
  readingTime,
  download,
  image,
  imageAlt,
  type = 'article',
} = Astro.props;

const dateDisplay = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
}).format(pubDate);

const topicLabel = TOPIC_LABELS[topic] ?? topic;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
>
  <article class="article-layout">

    <!-- Article header -->
    <header class="article-header">
      <div class="container">
        <div class="article-header-inner">
          <div class="article-meta-top">
            <a href={`/topic/${topic}`} class={`topic-pill ${topic}`}>{topicLabel}</a>
            <span class="content-type">{type}</span>
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>
          <div class="article-byline">
            <span>{dateDisplay}</span>
            {readingTime && <span>·</span>}
            {readingTime && <span>{readingTime} min read</span>}
            <span>·</span>
            <span>{author}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Hero image -->
    {image && (
      <div class="article-hero">
        <div class="container">
          <img src={image} alt={imageAlt ?? title} class="article-hero-img" loading="eager" />
        </div>
      </div>
    )}

    <!-- Ad slot: banner below header -->
    <div class="container">
      <div class="ad-slot ad-slot-banner" aria-hidden="true">
        <!-- AdSense banner 728×90 — replace with your ad unit code -->
        <span>Advertisement</span>
      </div>
    </div>

    <!-- Article body + sidebar -->
    <div class="container">
      <div class="article-columns">

        <!-- Main content -->
        <div class="article-content">

          <!-- Download banner (if asset exists) -->
          {download && (
            <div class="download-banner">
              <div>
                <p>Free download included with this article</p>
                <p><small>No sign-up required — grab it directly below.</small></p>
              </div>
              <a href={download} class="btn-download" download>
                ↓ Download free template
              </a>
            </div>
          )}

          <div class="prose">
            <slot />
          </div>

          <!-- In-article ad slot (mid-content, injected via slot) -->
          <div class="ad-slot ad-slot-in-article" aria-hidden="true">
            <!-- AdSense 336×280 in-article — replace with your ad unit code -->
            <span>Advertisement</span>
          </div>

          <!-- ProductionStudio CTA -->
          <div class="ps-cta">
            <div class="ps-cta-text">
              <h3>Need someone to implement this?</h3>
              <p>ProductionStudio helps marketing teams build the production infrastructure, workflows, and tooling covered in these articles.</p>
            </div>
            <a href="https://www.productionstud.io" class="btn-ps" target="_blank" rel="noopener">
              Work with us →
            </a>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="article-sidebar">

          <!-- Ad slot: sidebar rectangle -->
          <div class="ad-slot ad-slot-rect sticky-ad" aria-hidden="true">
            <!-- AdSense 300×250 sidebar — replace with your ad unit code -->
            <span>Advertisement</span>
          </div>

          <!-- Related topics -->
          <div class="sidebar-widget">
            <h4 class="sidebar-widget-title">Browse by topic</h4>
            <ul class="sidebar-topics">
              <li><a href="/topic/production-ops" class="topic-pill production-ops">Production Ops</a></li>
              <li><a href="/topic/creative-strategy" class="topic-pill creative-strategy">Creative Strategy</a></li>
              <li><a href="/topic/in-housing" class="topic-pill in-housing">In-housing</a></li>
              <li><a href="/topic/martech" class="topic-pill martech">Martech & Adtech</a></li>
              <li><a href="/topic/social-content" class="topic-pill social-content">Social & Content</a></li>
              <li><a href="/topic/video-motion" class="topic-pill video-motion">Video & Motion</a></li>
            </ul>
          </div>

          <!-- Templates promo -->
          <div class="sidebar-widget sidebar-promo">
            <p class="sidebar-promo-label">Free downloads</p>
            <p>Templates, checklists and playbooks — all free, no sign-up.</p>
            <a href="/templates" class="btn-download" style="display:inline-block;margin-top:0.75rem">Browse templates →</a>
          </div>

        </aside>
      </div>
    </div>

  </article>
</BaseLayout>

<style>
.article-header {
  background: var(--white);
  border-bottom: 1px solid var(--rule);
  padding-block: var(--s-12) var(--s-10);
}
.article-header-inner { max-width: var(--content-w); }
.article-meta-top {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-bottom: var(--s-5);
}
.article-title {
  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1.1;
  margin-bottom: var(--s-5);
  letter-spacing: -0.02em;
}
.article-description {
  font-size: var(--text-xl);
  color: var(--ink-2);
  max-width: 60ch;
  line-height: 1.6;
  margin-bottom: var(--s-6);
}
.article-byline {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  font-size: var(--text-sm);
  color: var(--ink-3);
}
.article-hero { padding-top: var(--s-8); }
.article-hero-img {
  width: 100%;
  max-height: 500px;
  object-fit: cover;
  border-radius: var(--r-lg);
}
.article-columns {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: var(--s-12);
  padding-top: var(--s-8);
}
@media (max-width: 960px) {
  .article-columns { grid-template-columns: 1fr; }
  .article-sidebar { display: none; }
}
.sticky-ad { position: sticky; top: 80px; }
.sidebar-widget {
  margin-top: var(--s-6);
  padding: var(--s-5);
  background: var(--paper-2);
  border-radius: var(--r-lg);
}
.sidebar-widget-title {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: var(--s-4);
}
.sidebar-topics { list-style: none; display: flex; flex-direction: column; gap: var(--s-2); }
.sidebar-promo { background: var(--accent-light); border: 1px solid #f5c4a0; }
.sidebar-promo .sidebar-promo-label {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: var(--s-2);
}
.sidebar-promo p { font-size: var(--text-sm); color: var(--ink-2); }
</style>
