---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPIC_LABELS } from '../../utils/topics';

const allArticles = await getCollection('articles');
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Articles - AndProducers"
  description="Weekly in-depth articles on creative production, marketing ops, in-housing, martech, social, and video production."
>
  <div class="page-header">
    <div class="container">
      <span class="content-type" style="margin-bottom:0.75rem;display:block">All articles</span>
      <h1>Industry articles</h1>
      <p>In-depth analysis, guides, and perspectives for marketing production professionals. New article every week.</p>
    </div>
  </div>

  <div class="container" style="margin-top:var(--s-12)">
    <!-- Topic filter pills -->
    <div class="filter-row">
      <a href="/articles" class="filter-pill active">All</a>
      <a href="/topic/production-ops" class="filter-pill">Production Ops</a>
      <a href="/topic/creative-strategy" class="filter-pill">Creative Strategy</a>
      <a href="/topic/in-housing" class="filter-pill">In-housing</a>
      <a href="/topic/martech" class="filter-pill">Martech & Adtech</a>
      <a href="/topic/social-content" class="filter-pill">Social & Content</a>
      <a href="/topic/video-motion" class="filter-pill">Video & Motion</a>
    </div>

    <!-- Ad slot -->
    <div class="ad-slot ad-slot-banner" aria-hidden="true" style="margin-bottom:var(--s-10)">
      <span>Advertisement</span>
    </div>

    <!-- Articles grid -->
    {sorted.length === 0 ? (
      <div class="empty-state">
        <p>Articles coming soon. Check back next week.</p>
      </div>
    ) : (
      <div class="grid-3">
        {sorted.map(article => (
          <a href={`/articles/${article.slug}`} class="card">
            <div class="card-image">
              {article.data.image
                ? <img src={article.data.image} alt={article.data.imageAlt ?? article.data.title} loading="lazy" />
                : <div class={`topic-card-bg ${article.data.topic}`}><span>{TOPIC_LABELS[article.data.topic]}</span></div>
              }
            </div>
            <div class="card-body">
              <span class={`topic-pill ${article.data.topic}`}>{TOPIC_LABELS[article.data.topic]}</span>
              <h2 class="card-title">{article.data.title}</h2>
              <p class="card-description">{article.data.description}</p>
              <div class="card-meta">
                <span>{new Intl.DateTimeFormat('en-GB', { day:'numeric', month:'short', year:'numeric' }).format(article.data.pubDate)}</span>
                {article.data.readingTime && <><span>·</span><span>{article.data.readingTime} min</span></>}
                {article.data.download && <span class="download-badge">↓ Download</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
.page-header {
  background: var(--white);
  border-bottom: 1px solid var(--rule);
  padding-block: var(--s-12) var(--s-10);
}
.page-header h1 { margin-bottom: var(--s-4); }
.page-header p { font-size: var(--text-lg); color: var(--ink-2); max-width: 55ch; }
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-8);
}
.filter-pill {
  padding: var(--s-2) var(--s-4);
  border-radius: 100px;
  border: 1px solid var(--rule);
  font-size: var(--text-sm);
  font-weight: 500;
  text-decoration: none;
  color: var(--ink-2);
  background: var(--white);
  transition: all 0.15s;
}
.filter-pill:hover, .filter-pill.active {
  background: var(--ink);
  color: var(--white);
  border-color: var(--ink);
}
.empty-state { text-align: center; padding: var(--s-20); color: var(--ink-3); }
.topic-card-bg {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.topic-card-bg.production-ops    { background: #fff0e8; color: var(--c-ops); }
.topic-card-bg.creative-strategy { background: #e8f0fb; color: var(--c-strategy); }
.topic-card-bg.in-housing        { background: #eaf4ec; color: var(--c-inhouse); }
.topic-card-bg.martech           { background: #f3eeff; color: var(--c-martech); }
.topic-card-bg.social-content    { background: #fce7f0; color: var(--c-social); }
.topic-card-bg.video-motion      { background: #e0f5f8; color: var(--c-video); }
.download-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-light);
  padding: 2px 8px;
  border-radius: 100px;
}
</style>
