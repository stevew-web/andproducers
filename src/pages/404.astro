---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found - AndProducers">
  <div style="text-align:center;padding:var(--s-24) var(--s-4)">
    <p style="font-size:5rem;font-family:var(--font-display);font-weight:900;color:var(--rule);line-height:1">404</p>
    <h1 style="font-size:var(--text-2xl);margin-bottom:var(--s-4)">Page not found</h1>
    <p style="color:var(--ink-3);margin-bottom:var(--s-8)">This page doesn't exist or has moved.</p>
    <a href="/" style="background:var(--ink);color:var(--paper);padding:var(--s-3) var(--s-8);border-radius:var(--r-md);text-decoration:none;font-weight:600">← Back to home</a>
  </div>
</BaseLayout>
