---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPIC_LABELS } from '../../utils/topics';

const allGuides = await getCollection('guides');
const sorted = allGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Guides - AndProducers"
  description="Evergreen how-to guides for creative production, marketing ops, in-housing, martech, social, and video production teams."
>
  <div class="page-header">
    <div class="container">
      <span class="content-type" style="margin-bottom:0.75rem;display:block">Guides</span>
      <h1>Evergreen guides</h1>
      <p>Comprehensive how-to content for building production capability. Many include free downloadable templates.</p>
    </div>
  </div>

  <div class="container" style="margin-top:var(--s-12)">
    <div class="ad-slot ad-slot-banner" aria-hidden="true" style="margin-bottom:var(--s-10)">
      <span>Advertisement</span>
    </div>

    {sorted.length === 0 ? (
      <div style="text-align:center;padding:var(--s-20);color:var(--ink-3)">
        <p>Guides coming soon.</p>
      </div>
    ) : (
      <div class="grid-3">
        {sorted.map(guide => (
          <a href={`/guides/${guide.slug}`} class="card">
            <div class="card-body">
              <div>
                <span class="content-type" style="display:block;margin-bottom:0.5rem">Guide</span>
                <span class={`topic-pill ${guide.data.topic}`}>{TOPIC_LABELS[guide.data.topic]}</span>
              </div>
              <h2 class="card-title">{guide.data.title}</h2>
              <p class="card-description">{guide.data.description}</p>
              <div class="card-meta">
                <span>{new Intl.DateTimeFormat('en-GB', { day:'numeric', month:'short', year:'numeric' }).format(guide.data.pubDate)}</span>
                {guide.data.download && <span class="download-badge">↓ Free download</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
.page-header { background: var(--white); border-bottom: 1px solid var(--rule); padding-block: var(--s-12) var(--s-10); }
.page-header h1 { margin-bottom: var(--s-4); }
.page-header p { font-size: var(--text-lg); color: var(--ink-2); max-width: 55ch; }
.download-badge { display: inline-flex; font-size: var(--text-xs); font-weight: 600; color: var(--accent); background: var(--accent-light); padding: 2px 8px; border-radius: 100px; }
</style>
