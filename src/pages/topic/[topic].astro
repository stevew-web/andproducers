---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPIC_LABELS, TOPIC_DESCRIPTIONS } from '../../utils/topics';

export async function getStaticPaths() {
  const topics = ['production-ops', 'creative-strategy', 'in-housing', 'martech', 'social-content', 'video-motion'];
  return topics.map(topic => ({ params: { topic } }));
}

const { topic } = Astro.params;
const topicLabel = TOPIC_LABELS[topic] ?? topic;
const topicDesc = TOPIC_DESCRIPTIONS[topic] ?? '';

const allArticles = await getCollection('articles', ({ data }) => data.topic === topic);
const allGuides = await getCollection('guides', ({ data }) => data.topic === topic);
const allTemplates = await getCollection('templates', ({ data }) => data.topic === topic);
const allPlaybooks = await getCollection('playbooks', ({ data }) => data.topic === topic);

const sortedArticles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${topicLabel} - AndProducers`}
  description={topicDesc}
>
  <div class={`topic-page-header ${topic}`}>
    <div class="container">
      <span class={`topic-pill ${topic}`}>{topicLabel}</span>
      <h1>{topicLabel}</h1>
      <p>{topicDesc}</p>
    </div>
  </div>

  <div class="container" style="margin-top:var(--s-12)">
    <!-- Ad slot -->
    <div class="ad-slot ad-slot-banner" aria-hidden="true" style="margin-bottom:var(--s-10)">
      <span>Advertisement</span>
    </div>

    {sortedArticles.length > 0 && (
      <>
        <div class="section-header"><h2>Articles</h2></div>
        <div class="grid-3" style="margin-bottom:var(--s-12)">
          {sortedArticles.map(article => (
            <a href={`/articles/${article.slug}`} class="card">
              <div class="card-body">
                <h3 class="card-title">{article.data.title}</h3>
                <p class="card-description">{article.data.description}</p>
                <div class="card-meta">
                  <span>{new Intl.DateTimeFormat('en-GB', { day:'numeric', month:'short', year:'numeric' }).format(article.data.pubDate)}</span>
                  {article.data.readingTime && <><span>·</span><span>{article.data.readingTime} min</span></>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {allGuides.length > 0 && (
      <>
        <div class="section-header"><h2>Guides</h2></div>
        <div class="grid-3" style="margin-bottom:var(--s-12)">
          {allGuides.map(guide => (
            <a href={`/guides/${guide.slug}`} class="card">
              <div class="card-body">
                <span class="content-type" style="display:block;margin-bottom:0.5rem">Guide</span>
                <h3 class="card-title">{guide.data.title}</h3>
                <p class="card-description">{guide.data.description}</p>
                {guide.data.download && <div class="card-meta"><span class="download-badge">↓ Free download</span></div>}
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {allTemplates.length > 0 && (
      <>
        <div class="section-header"><h2>Templates</h2></div>
        <div class="grid-3" style="margin-bottom:var(--s-12)">
          {allTemplates.map(tmpl => (
            <a href={`/templates/${tmpl.slug}`} class="card">
              <div class="card-body">
                <h3 class="card-title">{tmpl.data.title}</h3>
                <p class="card-description">{tmpl.data.description}</p>
                <div class="card-meta"><span class="download-badge">↓ Free download ({tmpl.data.fileType})</span></div>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {sortedArticles.length === 0 && allGuides.length === 0 && allTemplates.length === 0 && (
      <div style="text-align:center;padding:var(--s-20);color:var(--ink-3)">
        <p>Content for this topic coming soon.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
.topic-page-header {
  border-bottom: 1px solid var(--rule);
  padding-block: var(--s-12) var(--s-10);
  background: var(--white);
}
.topic-page-header .topic-pill { margin-bottom: var(--s-5); }
.topic-page-header h1 { margin-bottom: var(--s-4); }
.topic-page-header p { font-size: var(--text-lg); color: var(--ink-2); max-width: 60ch; }
.download-badge {
  display: inline-flex;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-light);
  padding: 2px 8px;
  border-radius: 100px;
}
</style>
